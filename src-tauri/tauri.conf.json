{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "yara",
	"version": "0.1.0",
	"identifier": "com.reghe.yara",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNEUzNEVERjM2OTgyQ0EKUldUS2dtbno3VFJPMG5xdUxVRUtucSs2WUlTdU5IV3krRkRrdjhEbllkdk9xdi9wRk51TExJQXAK",
			"endpoints": [
				"https://github.com/Miserz/yara/releases/latest/download/latest.json"
			],
			"createUpdaterArtifacts": true
		}
	},
	"app": {
		"windows": [
			{
				"title": "Yara",
				"width": 1200,
				"height": 800,
				"decorations": false,
				"transparent": true,
				"windowEffects": {
					"effects": ["acrylic"]
				}
			}
		],
		"security": {
			"csp": {
				"default-src": ["'self'", "customprotocol:", "asset:"],
				"script-src": ["'self'"],
				"style-src": ["'self'", "'unsafe-inline'"],
				"img-src": ["'self'", "asset:", "https:", "http:", "data:", "blob:"],
				"font-src": ["'self'", "data:"],
				"connect-src": [
					"'self'",
					"ipc:",
					"http://ipc.localhost",
					"https://*",
					"http://*",
					"ws://localhost:*",
					"http://localhost:*"
				],
				"media-src": ["'self'", "asset:", "data:", "blob:", "https:"],
				"object-src": ["'none'"],
				"base-uri": ["'self'"],
				"frame-src": ["'none'"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
